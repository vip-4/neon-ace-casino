# Neon Ace — security and cache policy
# Used by Netlify and Cloudflare Pages. See netlify.toml / vercel.json for equivalents.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/baccarat
  Cache-Control: public, max-age=0, must-revalidate

/baccarat.html
  Cache-Control: public, max-age=0, must-revalidate

/sicbo
  Cache-Control: public, max-age=0, must-revalidate

/sicbo.html
  Cache-Control: public, max-age=0, must-revalidate

/roulette
  Cache-Control: public, max-age=0, must-revalidate

/roulette.html
  Cache-Control: public, max-age=0, must-revalidate

/videopoker
  Cache-Control: public, max-age=0, must-revalidate

/videopoker.html
  Cache-Control: public, max-age=0, must-revalidate

/slots
  Cache-Control: public, max-age=0, must-revalidate

/slots.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/manifest.webmanifest
  Cache-Control: public, max-age=86400
